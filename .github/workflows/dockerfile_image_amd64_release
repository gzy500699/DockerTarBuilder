name: Dockerfile Image AMD64 Release

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest

    env:
      IMAGE_NAME: smartoam/minio:latest
      TAR_NAME: smartoam-minio-amd64.tar.gz

    steps:
      - name: Checkout
        uses: actions/checkout@v4


      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3


      - name: Build Docker Image
        run: |
          docker build \
            --platform linux/amd64 \
            -t $IMAGE_NAME .


      - name: Save Docker Image
        run: |
          docker save $IMAGE_NAME -o image.tar
          gzip -c image.tar > $TAR_NAME
          rm -f image.tar


      - name: Create Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: smartoam-minio-latest
          name: smartoam/minio latest AMD64
          files: |
            ${{ env.TAR_NAME }}
